<Window x:Class="WinTapeRecorder.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTapeRecorder Settings" Icon="Assets/WinTapeRecorder.ico" Width="860" Height="640" MinWidth="700" MinHeight="480" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock" x:Key="Label"><Setter Property="Margin" Value="0,10,0,3" /></Style>
    <Style TargetType="TextBlock" x:Key="Heading"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,18,0,2" /></Style>
    <Style TargetType="TextBlock" x:Key="Quiet"><Setter Property="Foreground" Value="#666" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,4,0,0" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,4" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,0" /></Style>
    <Style TargetType="TextBox" x:Key="Small"><Setter Property="Width" Value="80" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
    <!-- Explanations as callouts (a tinted panel with an accent edge), tables (a read-only list) and expandable panels, rather than loose grey text -->
    <Style TargetType="Border" x:Key="Callout"><Setter Property="Background" Value="#EEF4FB" /><Setter Property="BorderBrush" Value="#2F7FD8" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="CornerRadius" Value="3" /><Setter Property="Padding" Value="12,8" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
    <Style TargetType="Border" x:Key="Warning" BasedOn="{StaticResource Callout}"><Setter Property="Background" Value="#FFF6E5" /><Setter Property="BorderBrush" Value="#E0A030" /></Style>
    <Style TargetType="TextBlock" x:Key="CalloutText"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="#2B3340" /><Setter Property="LineHeight" Value="19" /></Style>
    <Style TargetType="Expander" x:Key="Panel"><Setter Property="Margin" Value="0,10,0,0" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#2F7FD8" /></Style>
    <Style TargetType="StackPanel" x:Key="PanelBody"><Setter Property="Margin" Value="0,6,0,4" /><Setter Property="TextElement.FontWeight" Value="Normal" /><Setter Property="TextElement.Foreground" Value="#1B1E24" /></Style>
    <Style TargetType="ListView" x:Key="Table">
      <Setter Property="BorderBrush" Value="#E2E2E2" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="White" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Focusable" Value="False" /><Setter Property="IsHitTestVisible" Value="False" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListViewItem"><Setter Property="Focusable" Value="False" /><Setter Property="Padding" Value="4,3" /><Setter Property="Foreground" Value="#1B1E24" /><Style.Triggers><Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter Property="Background" Value="#F6F8FB" /></Trigger></Style.Triggers></Style></Setter.Value></Setter>
      <Setter Property="AlternationCount" Value="2" />
    </Style>
    <!-- Settings pages in a left sidebar, grouped under small section headings; the page's name heads its content (as WinSqueeze) -->
    <Style TargetType="TabControl">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Background="#F3F3F3" BorderBrush="#E2E2E2" BorderThickness="0,0,1,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True" Margin="8,10" /></ScrollViewer></Border>
          <DockPanel Grid.Column="1"><TextBlock DockPanel.Dock="Top" Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}" FontSize="20" FontWeight="SemiBold" Margin="16,14,16,0" />
            <ContentPresenter ContentSource="SelectedContent" /></DockPanel>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="4" Padding="10,6" Margin="0,1"><Grid>
          <Border x:Name="selectedBar" Width="3" CornerRadius="1.5" Background="#2F7FD8" HorizontalAlignment="Left" Margin="-8,2,0,2" Visibility="Collapsed" />
          <ContentPresenter ContentSource="Header" /></Grid></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#E6E6E6" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#DDE8F6" /><Setter TargetName="selectedBar" Property="Visibility" Value="Visible" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem" x:Key="SectionHeader">
      <Setter Property="IsEnabled" Value="False" /><Setter Property="Focusable" Value="False" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <ContentPresenter ContentSource="Header" TextElement.Foreground="#888" TextElement.FontSize="11" TextElement.FontWeight="SemiBold" Margin="10,12,0,3" />
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <TabControl x:Name="settingsTabs">
    <TabItem Header="Recording" Style="{StaticResource SectionHeader}" />
    <TabItem Header="Recording profiles" x:Name="recordingTab">
      <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,16,0">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="addRecordingButton" Content="Add" Padding="8,3" Margin="0,0,4,0" />
            <Button x:Name="copyRecordingButton" Content="Copy" Padding="8,3" Margin="0,0,4,0" />
            <Button x:Name="removeRecordingButton" Content="Remove" Padding="8,3" Margin="0" />
          </StackPanel>
          <ListBox x:Name="recordingList" />
        </DockPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="recordingEditor" Margin="0,0,8,0">
            <TextBlock Style="{StaticResource Label}" Text="Name" Margin="0,0,0,3" />
            <TextBox x:Name="recordingNameBox" />
            <TextBlock Style="{StaticResource Label}" Text="Record from" />
            <DockPanel>
              <Button x:Name="refreshRecordingDevicesButton" DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" />
              <ComboBox x:Name="recordingDeviceCombo" DisplayMemberPath="Label" />
            </DockPanel>
<Border Style="{StaticResource Callout}" Margin="0,8,0,0"><TextBlock Style="{StaticResource CalloutText}" Text="An output device records what it plays (loopback), exactly as the player sends it. An input device records what comes in. Keep a loopback device's Windows volume at 100% while recording." /></Border>
            <TextBlock Style="{StaticResource Label}" Text="WAV format" />
            <ComboBox x:Name="bitDepthCombo" Width="200" HorizontalAlignment="Left">
              <ComboBoxItem Content="16-bit" Tag="16" />
              <ComboBoxItem Content="24-bit" Tag="24" />
              <ComboBoxItem Content="32-bit float" Tag="32" />
            </ComboBox>
            <TextBlock Style="{StaticResource Label}" Text="Sessions folder" />
            <DockPanel>
              <Button x:Name="openSessionsFolderButton" DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" />
              <Button x:Name="chooseSessionsFolderButton" DockPanel.Dock="Right" Content="Choose…" Margin="8,0,0,0" />
              <TextBox x:Name="sessionsFolderBox" IsReadOnly="True" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock Style="{StaticResource Heading}" Text="Track names" />
            <CheckBox x:Name="useMediaInfoBox" Content="Windows media info (what apps and browser tabs say is playing)" />
            <CheckBox x:Name="useWindowTitlesBox" Content="Browser window titles, through the rules on the Detection page" />
            <CheckBox x:Name="splitOnGapsBox" Content="With no names, split tracks on gaps" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="Mark a name change earlier by" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox x:Name="latencyBox" Style="{StaticResource Small}" />
              <TextBlock Text="ms" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="Gap detection" />
            <Border Style="{StaticResource Callout}" Margin="0,4,0,0"><TextBlock Style="{StaticResource CalloutText}" Text="Works like a noise gate: sound above the threshold for the attack time starts a track, silence for the release time ends it. Pre-roll and post-roll are kept either side. A name change looks for the nearest gap within its window. Changes apply to new recordings and to Redetect in a session." /></Border>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Threshold" VerticalAlignment="Center" Margin="0,4" />
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4"><Slider x:Name="thresholdSlider" Minimum="-90" Maximum="-20" Width="180" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" /><TextBlock x:Name="thresholdText" Width="90" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
              <TextBlock Grid.Row="1" Text="Minimum gap" VerticalAlignment="Center" Margin="0,4" /><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4"><TextBox x:Name="minGapBox" Style="{StaticResource Small}" /><TextBlock Text="ms" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
              <TextBlock Grid.Row="2" Text="Attack" VerticalAlignment="Center" Margin="0,4" /><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4"><TextBox x:Name="attackBox" Style="{StaticResource Small}" /><TextBlock Text="ms" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
              <TextBlock Grid.Row="3" Text="Release" VerticalAlignment="Center" Margin="0,4" /><StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4"><TextBox x:Name="releaseBox" Style="{StaticResource Small}" /><TextBlock Text="ms" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
              <TextBlock Grid.Row="4" Text="Pre-roll (kept before)" VerticalAlignment="Center" Margin="0,4" /><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4"><TextBox x:Name="preRollBox" Style="{StaticResource Small}" /><TextBlock Text="ms" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
              <TextBlock Grid.Row="5" Text="Post-roll (kept after)" VerticalAlignment="Center" Margin="0,4" /><StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4"><TextBox x:Name="postRollBox" Style="{StaticResource Small}" /><TextBlock Text="ms" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
              <TextBlock Grid.Row="6" Text="Look for a gap within" VerticalAlignment="Center" Margin="0,4" /><StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,4"><TextBox x:Name="snapBox" Style="{StaticResource Small}" /><TextBlock Text="ms of a name change" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
              <TextBlock Grid.Row="7" Text="Shortest unnamed track" VerticalAlignment="Center" Margin="0,4" /><StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,4"><TextBox x:Name="minTrackBox" Style="{StaticResource Small}" /><TextBlock Text="seconds" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
              <CheckBox Grid.Row="8" Grid.ColumnSpan="3" x:Name="trimSilenceBox" Content="Trim silence from the start and end of each track" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>
    <TabItem Header="Detection" x:Name="detectionTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <TextBlock Text="Browser programs (window titles are read from these)" />
        <TextBox x:Name="browsersBox" Margin="0,4,0,0" />
        <TextBlock Style="{StaticResource Heading}" Text="Rules" />
<Border Style="{StaticResource Callout}" Margin="0,4,0,0"><TextBlock Style="{StaticResource CalloutText}" Text="Each rule is a regular expression tried on a browser window's title, with the browser's name taken off. Named groups artist, title and album pick out the parts. The first rule that matches wins; with none, the whole title becomes the track name." /></Border>
        <Expander Style="{StaticResource Panel}" Header="The example rules"><StackPanel Style="{StaticResource PanelBody}"><ListView x:Name="rulesExampleTable" Style="{StaticResource Table}" Margin="0,0,0,0"><ListView.View><GridView><GridViewColumn Header="Site" DisplayMemberBinding="{Binding Key}" Width="150" /><GridViewColumn Header="A window title like…" DisplayMemberBinding="{Binding Value}" Width="440" /></GridView></ListView.View></ListView></StackPanel></Expander>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="addRuleButton" Content="Add" Padding="8,3" Margin="0,0,4,0" />
              <Button x:Name="removeRuleButton" Content="Remove" Padding="8,3" Margin="0,0,4,0" />
              <Button x:Name="ruleUpButton" Content="▲" Padding="6,3" Margin="0,0,4,0" ToolTip="Earlier (tried first)" />
              <Button x:Name="ruleDownButton" Content="▼" Padding="6,3" Margin="0" ToolTip="Later" />
            </StackPanel>
            <ListBox x:Name="rulesList" Height="150" />
          </DockPanel>
          <StackPanel Grid.Column="1" x:Name="ruleEditor">
            <TextBlock Text="Name" Margin="0,0,0,3" />
            <TextBox x:Name="ruleNameBox" />
            <CheckBox x:Name="ruleEnabledBox" Content="On" />
            <TextBlock Style="{StaticResource Label}" Text="Pattern" />
            <TextBox x:Name="rulePatternBox" FontFamily="Consolas" />
            <TextBlock x:Name="rulePatternError" Foreground="#B00020" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button x:Name="testRulesButton" Content="Test on what's open now" />
          <Button x:Name="resetRulesButton" Content="Restore the example rules" />
        </StackPanel>
        <TextBox x:Name="rulesTestBox" IsReadOnly="True" Height="170" Margin="0,8,0,0" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Output" Style="{StaticResource SectionHeader}" />
    <TabItem Header="Output profiles" x:Name="outputTab">
      <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,16,0">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="addOutputButton" Content="Add" Padding="8,3" Margin="0,0,4,0" />
            <Button x:Name="copyOutputButton" Content="Copy" Padding="8,3" Margin="0,0,4,0" />
            <Button x:Name="removeOutputButton" Content="Remove" Padding="8,3" Margin="0" />
          </StackPanel>
          <ListBox x:Name="outputList" />
        </DockPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Style="{StaticResource Label}" Text="Name" Margin="0,0,0,3" />
            <TextBox x:Name="outputNameBox" />
            <StackPanel Orientation="Horizontal">
              <StackPanel><TextBlock Style="{StaticResource Label}" Text="Format" />
                <ComboBox x:Name="formatCombo" Width="180">
                  <ComboBoxItem Content="FLAC (lossless)" Tag="flac" />
                  <ComboBoxItem Content="WAV" Tag="wav" />
                  <ComboBoxItem Content="MP3" Tag="mp3" />
                  <ComboBoxItem Content="AAC (.m4a)" Tag="m4a" />
                </ComboBox></StackPanel>
              <StackPanel x:Name="bitratePanel" Margin="16,0,0,0"><TextBlock Style="{StaticResource Label}" Text="Bitrate" />
                <ComboBox x:Name="bitrateCombo" Width="120">
                  <ComboBoxItem Content="128 kbps" Tag="128" />
                  <ComboBoxItem Content="192 kbps" Tag="192" />
                  <ComboBoxItem Content="256 kbps" Tag="256" />
                  <ComboBoxItem Content="320 kbps" Tag="320" />
                </ComboBox></StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="Output folder" />
            <DockPanel>
              <Button x:Name="openOutputFolderButton" DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" />
              <Button x:Name="chooseOutputFolderButton" DockPanel.Dock="Right" Content="Choose…" Margin="8,0,0,0" />
              <TextBox x:Name="outputFolderBox" IsReadOnly="True" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock Style="{StaticResource Label}" Text="Folders and file name (/ starts a folder)" />
            <TextBox x:Name="templateBox" FontFamily="Consolas" />
            <Border Style="{StaticResource Callout}" Margin="0,6,0,0"><StackPanel><TextBlock Text="Example" FontSize="11" FontWeight="SemiBold" Foreground="#2F7FD8" /><TextBlock x:Name="templateExampleText" Style="{StaticResource CalloutText}" FontFamily="Consolas" FontSize="12" /></StackPanel></Border>
            <Expander Style="{StaticResource Panel}" Header="Tokens you can use"><StackPanel Style="{StaticResource PanelBody}"><ListView x:Name="tokensTable" Style="{StaticResource Table}" Margin="0,0,0,0"><ListView.View><GridView><GridViewColumn Header="Token" DisplayMemberBinding="{Binding Key}" Width="130" /><GridViewColumn Header="Becomes" DisplayMemberBinding="{Binding Value}" Width="430" /></GridView></ListView.View></ListView><TextBlock Margin="0,6,0,0" Foreground="#555" TextWrapping="Wrap" Text="Characters Windows won't allow in a name are swapped for lookalikes. A / in the template starts a folder." /></StackPanel></Expander>
            <TextBlock Style="{StaticResource Heading}" Text="Tag defaults" />
            <Border Style="{StaticResource Callout}" Margin="0,4,0,0"><TextBlock Style="{StaticResource CalloutText}" Text="Normally leave these empty: tag the tracks themselves in the session (Tags…, or Look up… for MusicBrainz, iTunes and Discogs). Anything here is only used for a file whose track has that tag empty. Before exporting, tracks still missing artist, album, album artist or genre are pointed out." /></Border>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="Album" VerticalAlignment="Center" /><TextBox Grid.Column="1" x:Name="tagAlbumBox" Margin="0,3" />
              <TextBlock Grid.Row="1" Text="Album artist" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" x:Name="tagAlbumArtistBox" Margin="0,3" />
              <TextBlock Grid.Row="2" Text="Genre" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" x:Name="tagGenreBox" Margin="0,3" />
              <TextBlock Grid.Row="3" Text="Comment" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" x:Name="tagCommentBox" Margin="0,3" />
            </Grid>
            <TextBlock Style="{StaticResource Heading}" Text="Cover picture" />
            <CheckBox x:Name="embedCoverBox" Content="Put the cover inside each file's tags" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <CheckBox x:Name="saveCoverBox" Content="Also save it in the tracks' folder as" Margin="0" VerticalAlignment="Center" />
              <TextBox x:Name="coverNameBox" Width="140" Margin="8,0,4,0" />
              <TextBlock Text=".jpg or .png" VerticalAlignment="Center" Foreground="#666" />
            </StackPanel>
<Border Style="{StaticResource Callout}" Margin="0,8,0,0"><TextBlock Style="{StaticResource CalloutText}" Text="Pictures come from Tags… in a session: choose your own JPEG or PNG, or take one from an online lookup. A picture saved beside the tracks (folder.jpg) is what Windows and most players show for the album." /></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>
    <TabItem Header="Look" Style="{StaticResource SectionHeader}" />
    <TabItem Header="Appearance" x:Name="appearanceTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <TextBlock Style="{StaticResource Label}" Text="Skin" Margin="0,0,0,3" />
        <ComboBox x:Name="skinBox" Width="260" HorizontalAlignment="Left" Margin="0,0,0,14" />
        <TextBlock Style="{StaticResource Label}" Text="Accent colour" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <Border x:Name="accentSwatch" Width="28" Height="22" CornerRadius="4" BorderBrush="#40000000" BorderThickness="1" Margin="0,0,8,0" />
          <Button x:Name="accentChooseButton" Content="Choose…" Padding="10,2" Margin="0,0,6,0" />
          <Button x:Name="accentResetButton" Content="Reset to default" Padding="10,2" />
        </StackPanel>
        <TextBlock Style="{StaticResource Label}" Text="Size of everything in the main window" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <TextBlock Text="Scale" Width="100" VerticalAlignment="Center" />
          <Slider x:Name="uiScaleSlider" Minimum="75" Maximum="150" Width="220" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
          <TextBlock x:Name="uiScaleText" Width="50" Margin="8,0,0,0" VerticalAlignment="Center" />
          <Button x:Name="uiScaleResetButton" Content="Reset to 100%" Padding="10,2" />
        </StackPanel>
        <TextBlock Style="{StaticResource Label}" Text="Glass" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <TextBlock Text="Transparency" Width="100" VerticalAlignment="Center" />
          <Slider x:Name="glassTransparencySlider" Minimum="0" Maximum="100" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
          <TextBlock x:Name="glassTransparencyText" Width="80" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <TextBlock Text="Tint" Width="100" VerticalAlignment="Center" />
          <Slider x:Name="glassTintSlider" Minimum="0" Maximum="360" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
          <Border x:Name="glassTintSwatch" Width="22" Height="16" CornerRadius="3" Margin="8,0,0,0" BorderBrush="#40000000" BorderThickness="1" />
          <TextBlock x:Name="glassTintText" Width="60" Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="glassResetButton" Content="Reset glass to default" HorizontalAlignment="Left" Padding="10,2" Margin="100,2,0,8" />
        <CheckBox x:Name="glassInactiveBox" Content="Keep the glass when WinTapeRecorder isn't the active window" Margin="0,0,0,14" />
        <CheckBox x:Name="glassBox" Content="Glass: let the desktop show through the window, frosted (Windows 11)" />
        <CheckBox x:Name="framelessBox" Content="Frameless window (default): no title bar or standard border. Drag from the top strip, resize from the edges." Margin="0,8,0,0" />
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="App" Style="{StaticResource SectionHeader}" />
    <TabItem Header="General" x:Name="generalTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <StackPanel Orientation="Horizontal"><CheckBox x:Name="showHintsBox" Content="Show hints around the app" VerticalAlignment="Center" Margin="0" /><Button x:Name="resetHintsButton" Content="Show all hints again" Margin="12,0,0,0" Padding="10,2" /></StackPanel>
        <TextBlock Style="{StaticResource Heading}" Text="Settings file" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <Button x:Name="exportSettingsButton" Content="Export settings…" />
          <Button x:Name="importSettingsButton" Content="Import settings…" />
        </StackPanel>
        <TextBlock x:Name="settingsFileText" Style="{StaticResource Quiet}" Text="Profiles, rules and look, as a JSON file you can keep or copy to another PC." />
        <TextBlock Style="{StaticResource Heading}" Text="Online tag lookup" />
<Border Style="{StaticResource Callout}" Margin="0,4,0,0"><TextBlock Style="{StaticResource CalloutText}" Text="MusicBrainz (with Cover Art Archive pictures) and iTunes work without an account. Discogs needs your own free token: discogs.com › Settings › Developers › Generate new token, then paste it below. Amazon has no public catalogue to search." /></Border>
        <TextBlock Style="{StaticResource Label}" Text="Discogs token" />
        <PasswordBox x:Name="discogsTokenBox" Width="360" HorizontalAlignment="Left" />
        <TextBlock Style="{StaticResource Heading}" Text="Closing" />
        <Border Style="{StaticResource Callout}" Margin="0,4,0,0"><TextBlock Style="{StaticResource CalloutText}" Text="Close (X) quits WinTapeRecorder: there is no tray icon. It warns first if a recording or export is running, and what has been recorded so far is always kept." /></Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Audio" x:Name="audioTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <TextBlock Text="Audition through" FontWeight="SemiBold" />
        <DockPanel Margin="0,4,0,0">
          <Button x:Name="refreshDevicesButton" DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" />
          <ComboBox x:Name="auditionDeviceCombo" DisplayMemberPath="Label" />
        </DockPanel>
        <TextBlock Style="{StaticResource Label}" Text="Audition length (starts and ends)" />
        <ComboBox x:Name="auditionSecondsCombo" Width="160" HorizontalAlignment="Left">
          <ComboBoxItem Content="2 seconds" Tag="2" />
          <ComboBoxItem Content="5 seconds" Tag="5" />
          <ComboBoxItem Content="10 seconds" Tag="10" />
          <ComboBoxItem Content="20 seconds" Tag="20" />
        </ComboBox>
        <TextBlock Style="{StaticResource Heading}" Text="Devices on this PC" />
        <TextBox x:Name="devicesBox" IsReadOnly="True" Height="160" Margin="0,4,0,0" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
<Border Style="{StaticResource Callout}" Margin="0,8,0,0"><TextBlock Style="{StaticResource CalloutText}" Text="What to record from is chosen in each recording profile, not here. Refresh after plugging a device in." /></Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Shortcuts" x:Name="shortcutsTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <TextBlock Text="Recording" FontWeight="SemiBold" />
        <ListView x:Name="recordingKeysTable" Style="{StaticResource Table}" Margin="0,6,0,0"><ListView.View><GridView><GridViewColumn Header="Key" DisplayMemberBinding="{Binding Key}" Width="150" /><GridViewColumn Header="Does" DisplayMemberBinding="{Binding Value}" Width="470" /></GridView></ListView.View></ListView>
        <TextBlock Text="Waveform" FontWeight="SemiBold" Margin="0,16,0,0" />
        <ListView x:Name="waveformKeysTable" Style="{StaticResource Table}" Margin="0,6,0,0"><ListView.View><GridView><GridViewColumn Header="Key or mouse" DisplayMemberBinding="{Binding Key}" Width="150" /><GridViewColumn Header="Does" DisplayMemberBinding="{Binding Value}" Width="470" /></GridView></ListView.View></ListView>
        <TextBlock Text="Editing" FontWeight="SemiBold" Margin="0,16,0,0" />
        <ListView x:Name="editingKeysTable" Style="{StaticResource Table}" Margin="0,6,0,0"><ListView.View><GridView><GridViewColumn Header="Key" DisplayMemberBinding="{Binding Key}" Width="150" /><GridViewColumn Header="Does" DisplayMemberBinding="{Binding Value}" Width="470" /></GridView></ListView.View></ListView>
        <TextBlock Text="Listening and export" FontWeight="SemiBold" Margin="0,16,0,0" />
        <ListView x:Name="listeningKeysTable" Style="{StaticResource Table}" Margin="0,6,0,0"><ListView.View><GridView><GridViewColumn Header="Key" DisplayMemberBinding="{Binding Key}" Width="150" /><GridViewColumn Header="Does" DisplayMemberBinding="{Binding Value}" Width="470" /></GridView></ListView.View></ListView>
        <TextBlock Text="App" FontWeight="SemiBold" Margin="0,16,0,0" />
        <ListView x:Name="appKeysTable" Style="{StaticResource Table}" Margin="0,6,0,0"><ListView.View><GridView><GridViewColumn Header="Key" DisplayMemberBinding="{Binding Key}" Width="150" /><GridViewColumn Header="Does" DisplayMemberBinding="{Binding Value}" Width="470" /></GridView></ListView.View></ListView>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="About" x:Name="aboutTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
          <TextBlock x:Name="versionText" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="dataFolderText" Style="{StaticResource Quiet}" />
          <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,16,0,4" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Channel" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="channelCombo" Width="200" Margin="0,0,12,0">
              <ComboBoxItem Content="Stable releases" Tag="stable" />
              <ComboBoxItem Content="Dev builds (every change)" Tag="dev" />
            </ComboBox>
            <CheckBox x:Name="autoUpdateBox" Content="Download updates automatically" VerticalAlignment="Center" Margin="0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="checkNowButton" Content="Check now" />
            <Button x:Name="restartToUpdateButton" Content="Restart to update" Visibility="Collapsed" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock x:Name="updateStatusText" Style="{StaticResource Quiet}" />
          <TextBlock Text="Versions" FontWeight="SemiBold" Margin="0,16,0,4" />
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
              <Button x:Name="refreshVersionsButton" Content="Refresh" Margin="0,0,0,6" />
              <Button x:Name="switchVersionButton" Content="Switch to this" IsEnabled="False" />
            </StackPanel>
            <ListBox x:Name="versionsList" Height="150">
              <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}" /><TextBlock Text="  ✔ running now" Foreground="#2E9E44" FontWeight="SemiBold" Visibility="{Binding CurrentVisibility}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <TextBlock x:Name="versionNotesText" Style="{StaticResource Quiet}" />
          <TextBlock Margin="0,4,0,0"><Hyperlink x:Name="versionDiscussionLink">Comments for this version</Hyperlink></TextBlock>
          <TextBlock Style="{StaticResource Quiet}" Margin="0,16,0,0" Text="WinTapeRecorder is free software under the GNU GPL v3. It uses NAudio (MIT) and TagLib# (LGPL)." />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="openLogsButton" Content="Open logs folder" /></StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
